; STM32F407ZG relocated app scatter file for OTA.
; Runtime app occupies sectors 5-7: 0x08020000 - 0x0807FFFF.

LR_IROM1 0x08020000 0x00060000  {
  ER_IROM1 0x08020000 0x00060000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x0001C000  {
    .ANY (+RW +ZI)
  }
  RW_IRAM2 0x2001C000 0x00004000  {
    .ANY (+RW +ZI)
  }
}
